# Copy to .env and edit.
# Postgres (recommended):
# DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apexpulse
# Local quick start (SQLite):
DATABASE_URL=sqlite:///./apexpulse.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# AI features. Without a key, log parsing / routine generator / insights still work using built-in rules;
# only the coach chat needs it. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
